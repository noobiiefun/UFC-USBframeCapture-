<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="YouTube RTMP Settings"
            android:textStyle="bold"
            android:textSize="18sp" />

        <EditText
            android:id="@+id/editRtmpUrl"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="RTMP Server URL"
            android:inputType="textUri" />

        <EditText
            android:id="@+id/editStreamKey"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Stream Key"
            android:inputType="textPassword" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Video Configuration"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/editWidth"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="Width (e.g. 1280)"
                android:inputType="number" />

            <EditText
                android:id="@+id/editHeight"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="Height (e.g. 720)"
                android:inputType="number" />
        </LinearLayout>

        <EditText
            android:id="@+id/editFps"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="FPS (15, 30, 60)"
            android:inputType="number" />

        <EditText
            android:id="@+id/editBitrate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Bitrate (kbps)"
            android:inputType="number" />

        <Button
            android:id="@+id/btnSave"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:text="Save Settings" />

    </LinearLayout>
</ScrollView>
